# Sample Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ============================================
# Blockchain Configuration
# ============================================

# Ethereum/Polygon RPC endpoint
# Get free key from: https://infura.io or https://alchemy.com
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private key for anchoring transactions (DO NOT SHARE!)
# This should be a wallet with sufficient ETH/MATIC for gas
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# AnchorRegistry smart contract address
# This will be set after contract deployment
ANCHOR_CONTRACT=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# Network name (mainnet, sepolia, polygon, mumbai, etc.)
NETWORK_NAME=mainnet

# ============================================
# Antigravity Attestation (Optional)
# ============================================

# Antigravity API endpoint
ANTIGRAVITY_URL=https://api.antigravity.example.com/v1/attest

# Antigravity API key for authentication
ANTIGRAVITY_API_KEY=your_antigravity_api_key_here

# HMAC secret for enhanced security (optional)
ANTIGRAVITY_HMAC_SECRET=your_hmac_secret_here

# ============================================
# Monitoring & Alerts (Optional)
# ============================================

# Slack webhook URL for monitoring alerts
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# Deployment Configuration (Optional)
# ============================================

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# Advanced Options (Optional)
# ============================================

# Custom scores directory (default: ./scores)
# SCORES_DIR=./custom/scores

# Custom proofs output file (default: ./scores/proofs.json)
# OUTPUT_FILE=./custom/proofs.json

# Hash algorithm (default: sha256)
# HASH_ALGO=sha256

# ============================================
# Development / Testing
# ============================================

# Set to 'true' to enable debug logging
# DEBUG=false

# Set to 'true' to skip on-chain verification (testing only)
# SKIP_ONCHAIN_VERIFY=false
